<mvc:View controllerName="vendordoclines.controller.Cockpit"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  height="100%">

  <Page id="dashboardPage" showHeader="false" enableScrolling="true" class="vrDashboardPage">
    <!-- ============ HEADER BAR ============ -->
    <Toolbar class="vrHeaderBar" height="4rem" design="Solid">
      <VBox>
        <HBox alignItems="Center">
          <Image src="images/reconly_box_dark.png" height="32px" class="sapUiTinyMarginEnd" alt="Reconly Mark"/>
          <Image src="images/reconly_brand_dark.png" height="24px" class="sapUiSmallMarginEnd" alt="Reconly"/>
          <Title text="Executive Analytics Dashboard" class="vrHeaderTitle" level="H2"/>
        </HBox>
        <Text text="Accounts Payable • Statement Matching • Real-time Analytics" class="vrHeaderSubtitle"/>
      </VBox>
      <ToolbarSpacer/>
      <Label text="Time Range:" class="sapUiTinyMarginEnd"/>
      <Select id="timeRangeSelect" selectedKey="30d" width="10.5rem" change=".onTimeRangeChange">
        <core:Item key="24h" text="Last 24 Hours"/>
        <core:Item key="7d"  text="Last 7 Days"/>
        <core:Item key="30d" text="Last 30 Days (MTD)"/>
      </Select>
      <Button id="btnCockpitRefresh" icon="sap-icon://refresh" text="Refresh" press=".onRefreshDashboard" tooltip="Reload live dashboard data"/>
      <Button icon="sap-icon://excel-attachment" text="Export Report" type="Emphasized" press=".onExportReport"/>
    </Toolbar>

    <!-- ============ KPI CARDS ROW ============ -->
    <core:HTML id="kpiHost" content="&lt;div class=&quot;vrKpiGrid&quot;&gt;&lt;/div&gt;"/>

    <!-- ============ ACTIVE DRILLDOWN FILTER BANNER ============ -->
    <HBox id="kpiFilterBanner" visible="false" alignItems="Center" justifyContent="SpaceBetween" class="vrKpiFilterBanner sapUiSmallMarginBeginEnd sapUiTinyMarginBottom">
      <HBox alignItems="Center">
        <core:Icon src="sap-icon://filter" size="0.95rem" color="#2563EB" class="sapUiTinyMarginEnd"/>
        <Text id="kpiFilterText" text="Filtered View" class="vrKpiFilterText"/>
      </HBox>
      <HBox alignItems="Center">
        <Button text="View in Match Results →" type="Emphasized" press=".onGoToMatchResults" class="sapUiTinyMarginEnd"/>
        <Button text="Reset Filter" icon="sap-icon://clear-filter" type="Transparent" press=".onClearKpiFilter" class="vrResetFilterBtn"/>
      </HBox>
    </HBox>

    <!-- ============ CHART GRID ============ -->
    <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="sapUiSmallMarginBeginEnd">
      <VBox class="vrChartCard">
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://pie-chart" size="1.05rem" color="#2563EB" class="sapUiTinyMarginEnd"/>
            <Title text="Status Distribution" class="vrChartTitle" level="H4"/>
          </HBox>
        </HBox>
        <core:HTML id="chartStatusDist" content="&lt;div class=&quot;vrChartHost&quot;&gt;&lt;/div&gt;"/>
      </VBox>

      <VBox class="vrChartCard">
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://supplier" size="1.05rem" color="#EF4444" class="sapUiTinyMarginEnd"/>
            <Title text="Top Vendors by Mismatch" class="vrChartTitle" level="H4"/>
          </HBox>
        </HBox>
        <core:HTML id="chartMismatchVendor" content="&lt;div class=&quot;vrChartHost&quot;&gt;&lt;/div&gt;"/>
      </VBox>

      <VBox class="vrChartCard">
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://line-chart" size="1.05rem" color="#10B981" class="sapUiTinyMarginEnd"/>
            <Title text="Reconciliation Trend" class="vrChartTitle" level="H4"/>
          </HBox>
        </HBox>
        <core:HTML id="chartTrend" content="&lt;div class=&quot;vrChartHost&quot;&gt;&lt;/div&gt;"/>
      </VBox>

      <VBox class="vrChartCard">
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
          <HBox alignItems="Center">
            <core:Icon src="sap-icon://alert" size="1.05rem" color="#F59E0B" class="sapUiTinyMarginEnd"/>
            <Title text="Exception Categories" class="vrChartTitle" level="H4"/>
          </HBox>
        </HBox>
        <core:HTML id="chartVarianceType" content="&lt;div class=&quot;vrChartHost&quot;&gt;&lt;/div&gt;"/>
      </VBox>
    </l:Grid>
    
  </Page>
</mvc:View>