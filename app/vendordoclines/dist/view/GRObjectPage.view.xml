<mvc:View controllerName="vendordoclines.controller.GRObjectPage"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m"
          xmlns:uxap="sap.uxap"
          xmlns:layout="sap.ui.layout"
          xmlns:f="sap.ui.layout.form"
          xmlns:u="sap.ui.unified"
          xmlns:core="sap.ui.core">

    <uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="true" alwaysShowContentHeader="true" preserveHeaderStateOnScroll="false" headerContentPinnable="true" isChildPage="true">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:heading>
                    <Title text="Post Goods Receipt: PO {purchaseOrder}"/>
                </uxap:heading>
                <uxap:expandedHeading>
                    <Title text="Post Goods Receipt: PO {purchaseOrder}"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="Post Goods Receipt: PO {purchaseOrder}"/>
                </uxap:snappedHeading>
                
                <uxap:actions>
                    <Button text="Post Document" type="Accept" icon="sap-icon://accept" press="onConfirmGR"/>
                    <Button text="Cancel" type="Reject" press="onCancelGR"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        
        <uxap:headerContent>
            <ObjectAttribute title="Supplier" text="{supplier}"/>
            <ObjectAttribute title="Material" text="{material}"/>
            <ObjectStatus title="Total Ordered" text="{poQty}"/>
            <ObjectStatus title="Already Received" text="{receivedQty}" state="Warning"/>
            <ObjectStatus title="Pending To Receive" text="{ parts: [{path:'poQty', targetType:'any'}, {path:'receivedQty', targetType:'any'}], formatter: '.formatPendingQty' }" state="Error"/>
        </uxap:headerContent>

        <uxap:sections>
            <uxap:ObjectPageSection titleUppercase="false" title="Material Document Data">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1">
                                <f:content>
                                    <Label text="Quantity Received" required="true"/>
                                    <Input id="grQty" type="Number"/>
                                    
                                    <Label text="Plant" required="true"/>
                                    <Input id="grPlant" value="1010"/>
                                </f:content>
                            </f:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            
            <uxap:ObjectPageSection titleUppercase="false" title="Quality Inspection (SAP QM)">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1">
                                <f:content>
                                    <Label text="Stock Posting Type" required="true"/>
                                    <Select id="grStockType" width="100%">
                                        <core:Item key="Unrestricted Use" text="Unrestricted Use (Available)"/>
                                        <core:Item key="Quality Inspection" text="Quality Inspection (Q)"/>
                                        <core:Item key="Blocked Stock" text="Blocked Stock (Restricted)"/>
                                    </Select>
                    
                                    <Label text="Usage Decision (Quality Status)" required="true"/>
                                    <Select id="grQualityStatus" width="100%" change="onQualityStatusChange">
                                        <core:Item key="Accepted" text="Accepted (Pass)"/>
                                        <core:Item key="Rejected" text="Rejected (Fail)"/>
                                        <core:Item key="Pending" text="Pending Analysis"/>
                                    </Select>
                    
                                    <Label id="grDefectCodeLabel" text="Defect Code" required="true" visible="false"/>
                                    <Select id="grDefectCode" width="100%" visible="false">
                                        <core:Item key="" text="Select Defect..."/>
                                        <core:Item key="QM-01" text="QM-01: Damaged Packaging"/>
                                        <core:Item key="QM-02" text="QM-02: Substandard Material"/>
                                        <core:Item key="QM-03" text="QM-03: Quantity Shortage"/>
                                    </Select>
                    
                                    <Label text="Inspector Remarks"/>
                                    <TextArea id="grRemarks" width="100%" rows="4"/>
                    
                                    <Label text="Upload Product Image (QA Evidence)"/>
                                    <u:FileUploader
                                        id="grImageUploader"
                                        width="100%"
                                        fileType="jpg,jpeg,png"
                                        change="onImageUpload"
                                        placeholder="Snap/Upload delivery image..."/>
                                </f:content>
                            </f:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
