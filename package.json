{
  "name": "vendor_reconcile",
  "version": "1.0.0",
  "description": "Vendor Reconciliation & Match Exception Engine",
  "main": "index.js",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --port 4005"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds": "^10.0.3",
    "@sap/xsenv": "^6.2.1",
    "@sap/xssec": "^4",
    "better-sqlite3": "^11.10.0 || ^12.0.0",
    "passport": "^0.7.0",
    "puppeteer": "^25.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "playwright": "^1.61.1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "sqlite.db",
          "driver": "better-sqlite3"
        }
      },
      "auth": {
        "kind": "mocked"
      },
      "[production]": {
        "auth": {
          "kind": "mocked"
        }
      },
      "html5-repo": true
    }
  }
}